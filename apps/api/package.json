{
    "name": "@code-mentor/api",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "db:generate": "prisma generate --schema ../../packages/database/prisma/schema.prisma",
        "db:migrate": "prisma migrate dev --schema ../../packages/database/prisma/schema.prisma",
        "db:deploy": "prisma migrate deploy --schema ../../packages/database/prisma/schema.prisma"
    },
    "dependencies": {
        "@google/genai": "^0.2.0",
        "@prisma/client": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.9.0",
        "prisma": "^6.19.3",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}